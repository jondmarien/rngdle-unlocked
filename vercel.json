        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|slurp|discord|twitter|facebook|slack|linkedin|telegram|whatsapp|preview|embed).*"
        }
      ],
      "destination": "/api/page/collection"
    },
    {
      "source": "/showcase",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|slurp|discord|twitter|facebook|slack|linkedin|telegram|whatsapp|preview|embed).*"
        }
      ],
      "destination": "/api/page/showcase"
    },
    {
      "source": "/stats",
