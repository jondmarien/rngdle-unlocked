        }
      ],
      "destination": "/api/page/terms"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|slurp|discord|twitter|facebook|slack|linkedin|telegram|whatsapp|preview|embed).*"
        }
      ],
      "destination": "/api/page/privacy"
    },
    {
      "source": "/roll",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|slurp|discord|twitter|facebook|slack|linkedin|telegram|whatsapp|preview|embed).*"
        }
      ],
      "destination": "/api/page/home"
    },
    {
      "source": "/api/share/r/(.*)",
      "destination": "/api/share/$1"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?__path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
