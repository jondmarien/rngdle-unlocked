{
  "name": "rngdle-unlocked",
  "private": true,
  "version": "0.16.2",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "build:vercel": "pnpm typecheck && vite build && pnpm bundle:api",
    "bundle:api": "node scripts/bundle-api.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "postinstall": "node scripts/patch-typescript-api.cjs",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "preview": "vite preview",
    "test": "vp test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@neondatabase/serverless": "^1.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.13.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "oxlint-tailwindcss": "^1.3.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vite-plus": "^0.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.25.0"
    }
  }
}
