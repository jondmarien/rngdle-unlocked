# Neon (from Vercel Neon integration or console.neon.tech)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Better Auth — required on Vercel too (Project → Settings → Environment Variables)
BETTER_AUTH_SECRET=generate-a-long-random-string
# Local:
BETTER_AUTH_URL=http://localhost:5173
# Production (must be your real site origin, not localhost):
# BETTER_AUTH_URL=https://your-app.vercel.app

# Optional client origin (same as BETTER_AUTH_URL in most setups)
VITE_APP_URL=http://localhost:5173

# Optional comma-separated extra Better Auth trustedOrigins (CORS / CSRF)
# Production + beta chron0.tech domains are already hardcoded in server/auth.ts.
# EXTRA_TRUSTED_ORIGINS=https://preview.example.com

# OAUTH APPS
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Outbound email (Resend) — magic link + email verification
RESEND_API_KEY=
# Verified domain sender (default uses outreach.chron0.tech)
EMAIL_FROM=RNGdle Unlocked <noreply@outreach.chron0.tech>

# Admin
ADMIN_SECRET=   # bootstrap / break-glass only
ADMIN_USER_IDS= # optional comma-separated bootstrap
